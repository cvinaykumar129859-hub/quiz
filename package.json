{
  "name": "quizmaster",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace backend run dev",
    "dev:web": "npm --workspace frontend run dev",
    "start": "npm --workspace backend run start",
    "build": "npm run build --workspaces --if-present",
    "seed": "npm --workspace backend run seed"
  },
  "devDependencies": { "concurrently": "^9.1.2" }
}
